( 03 / PostgreSQL and pgvector) Tj T*
( What, why and how) Tj T*
( db opens a psycopg connection, registers vector support and applies tenant context when present.) Tj T*
( initialize creates tables and indexes. audit records activity. Chunks hold text and vectors;) Tj T*
( workflows hold state; DLQ holds failures; feedback holds ratings. GIN supports full-text search;) Tj T*
( HNSW supports approximate vector retrieval. Parameterized SQL separates data from SQL syntax.) Tj T*
( Connection context managers commit or roll back.) Tj T*
() Tj T*
( Practical learning) Tj T*
( Inspect the schema after --init. Explain why a single relational database can serve both vector and) Tj T*
( transactional workloads.) Tj T*
() Tj T*
( Original source | lines 129-195) Tj T*
(   129 | def db\(\):) Tj T*
(   130 |     # Import dependencies used by the following code.) Tj T*
(   131 |     import psycopg # lazy import lets --tests work without installed dependencies) Tj T*
(   132 |     # Import dependencies used by the following code.) Tj T*
(   133 |     from pgvector.psycopg import register_vector) Tj T*
(   134 |     # Store psycopg.connect\(os.getenv\('ARINOVA_APP_DATABASE_URL', C.dsn\)\) in connection.) Tj T*
(   135 |     connection=psycopg.connect\(os.getenv\('ARINOVA_APP_DATABASE_URL', C.dsn\)\)) Tj T*
(   136 |     # Call register_vector to perform this step.) Tj T*
(   137 |     register_vector\(connection\)) Tj T*
(   138 |     # RLS context is scoped to each transaction; fail closed for app role when enabled.) Tj T*
(   139 |     # Store TENANT_CONTEXT.get\(\) in tenant_ctx.) Tj T*
(   140 |     tenant_ctx=TENANT_CONTEXT.get\(\)) Tj T*
(   141 |     # Check os.getenv\('ARINOVA_ENABLE_RLS'\) == '1'; execute this branch only if true.) Tj T*
(   142 |     if os.getenv\('ARINOVA_ENABLE_RLS'\) == '1':) Tj T*
(   143 |         # Check not tenant_ctx; execute this branch only if true.) Tj T*
(   144 |         if not tenant_ctx: raise PermissionError\('RLS requires verified tenant context'\)) Tj T*
(   145 |         # Call connection.execute to perform this step.) Tj T*
(   146 |         connection.execute\('SELECT set_config\(%s,%s,true\)',\('app.tenant_id',tenant_ctx\)\)) Tj T*
() Tj T*
(   147 |     # Return connection to the caller.) Tj T*
(   148 |     return connection) Tj T*
(   149 |) Tj T*
(   150 | # Define initialize; inputs: none. The body runs only when called.) Tj T*
(   151 | def initialize\(\):) Tj T*
(   152 |     # pgvector extension must be installed on the PostgreSQL server.) Tj T*
(   153 |     # Import dependencies used by the following code.) Tj T*
(   154 |     import psycopg) Tj T*
(   155 |     # Enter managed resource/context; cleanup occurs on exit, including exceptions.) Tj T*
(   156 |     with psycopg.connect\(C.dsn\) as conn:) Tj T*
(   157 |         # Call conn.execute to perform this step.) Tj T*
(   158 |         conn.execute\('CREATE EXTENSION IF NOT EXISTS vector'\)) Tj T*
(   159 |         # Call conn.execute to perform this step.) Tj T*
(   160 |         conn.execute\('''CREATE TABLE IF NOT EXISTS chunks \() Tj T*
(   161 |             id TEXT PRIMARY KEY, tenant TEXT NOT NULL, document_id TEXT NOT NULL,) Tj T*
(   162 |             page INTEGER NOT NULL, content TEXT NOT NULL, embedding vector\(384\) NOT NULL,) Tj T*
(   163 |             search_tsv tsvector GENERATED ALWAYS AS \(to_tsvector\('english',content\)\) STORED\)'''\)) Tj T*
(   164 |         # Call conn.execute to perform this step.) Tj T*
() Tj T*
(   165 |         conn.execute\('CREATE INDEX IF NOT EXISTS chunks_tenant_idx ON chunks\(tenant\)'\)) Tj T*
(   166 |         # Call conn.execute to perform this step.) Tj T*
(   167 |         conn.execute\('CREATE INDEX IF NOT EXISTS chunks_lex_idx ON chunks USING GIN\(search_tsv\)'\)) Tj T*
(   168 |         # Call conn.execute to perform this step.) Tj T*
(   169 |         conn.execute\('CREATE INDEX IF NOT EXISTS chunks_vec_idx ON chunks USING hnsw\(embedding) Tj T*
(       | vector_cosine_ops\)'\)) Tj T*
(   170 |         # Call conn.execute to perform this step.) Tj T*
(   171 |         conn.execute\('''CREATE TABLE IF NOT EXISTS workflows \() Tj T*
(   172 |             id TEXT PRIMARY KEY, tenant TEXT NOT NULL, actor TEXT NOT NULL,) Tj T*
(   173 |             status TEXT NOT NULL, state JSONB NOT NULL, updated_at TIMESTAMPTZ DEFAULT now\(\)\)'''\)) Tj T*
(   174 |         # Call conn.execute to perform this step.) Tj T*
(   175 |         conn.execute\('''CREATE TABLE IF NOT EXISTS dlq \() Tj T*
(   176 |             id TEXT PRIMARY KEY, tenant TEXT NOT NULL, request_key TEXT NOT NULL,) Tj T*
