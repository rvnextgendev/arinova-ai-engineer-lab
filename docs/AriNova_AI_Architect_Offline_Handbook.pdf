(   567 | # ----- 10B UNIFIED ENFORCED PIPELINE \(the only CLI ask entrypoint\).) Tj T*
(   568 | # Request boundary -> identity -> RBAC -> input guardrail -> idempotency ->) Tj T*
(   569 | # durable workflow -> retrieval -> generation -> output guardrail -> eval ->) Tj T*
(   570 | # persistence. Observability, cancellation and recovery are CROSS-CUTTING.) Tj T*
(   571 | # A real HTTP endpoint must pass a signed access token, never caller-supplied roles.) Tj T*
() Tj T*
