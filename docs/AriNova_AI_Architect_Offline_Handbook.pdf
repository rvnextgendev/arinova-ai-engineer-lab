( 06 / Hybrid retrieval, RRF and reranking) Tj T*
( What, why and how) Tj T*
( Vector search finds semantic similarity using pgvector cosine distance \(<=>\). PostgreSQL full-text) Tj T*
( search finds lexical matches. RRF combines ranking positions instead of incompatible raw scores:) Tj T*
( sum of 1/\(k+rank\), with k=60 by default. Cross-encoder reranking examines question and) Tj T*
( candidate together to refine relevance. Tenant filters must apply before results are exposed.) Tj T*
() Tj T*
( Practical learning) Tj T*
( For vector rank 1 and keyword rank 3, RRF = 1/61 + 1/63 = 0.032266. A missing result contributes) Tj T*
( zero. Compare a policy code HR-102 with a paraphrased leave question. Rerank only a limited) Tj T*
( candidate set.) Tj T*
() Tj T*
( Original source | lines 311-360) Tj T*
(   311 | # ----- 06 REAL hybrid search: two separate SQL queries; rank fusion; reranking.) Tj T*
(   312 | # Define reciprocal_rank_fusion; inputs: vector_rows, lexical_rows, k. The body runs only when called.) Tj T*
(   313 | def reciprocal_rank_fusion\(vector_rows,lexical_rows,k=60\):) Tj T*
(   314 |     # Store {} in scores.) Tj T*
(   315 |     scores={}; by_id={}) Tj T*
(   316 |     # Process each rows from \(vector_rows, lexical_rows\).) Tj T*
(   317 |     for rows in \(vector_rows,lexical_rows\):) Tj T*
(   318 |         # Process each \(rank, row\) from enumerate\(rows, 1\).) Tj T*
(   319 |         for rank,row in enumerate\(rows,1\):) Tj T*
(   320 |             # Store row[0] in chunk_id.) Tj T*
(   321 |             chunk_id=row[0]; by_id[chunk_id]=row) Tj T*
(   322 |             # Store scores.get\(chunk_id, 0\) + 1 / \(k + rank\) in scores[chunk_id].) Tj T*
(   323 |             scores[chunk_id]=scores.get\(chunk_id,0\)+1/\(k+rank\)) Tj T*
(   324 |     # Return [by_id[key] for key in sorted\(scores, key=scores.get, reverse=True\)] to the caller.) Tj T*
(   325 |     return [by_id[key] for key in sorted\(scores,key=scores.get,reverse=True\)]) Tj T*
(   326 |) Tj T*
(   327 | # Define hybrid_search; inputs: question, tenant, top_k. The body runs only when called.) Tj T*
(   328 | def hybrid_search\(question: str,tenant: str,top_k=5\):) Tj T*
() Tj T*
(   329 |     # Store embed\([question]\)[0] in vector.) Tj T*
(   330 |     vector=embed\([question]\)[0]) Tj T*
(   331 |     # Enter managed resource/context; cleanup occurs on exit, including exceptions.) Tj T*
(   332 |     with db\(\) as conn:) Tj T*
(   333 |         # WHERE tenant = %s is critical: prevent cross-tenant retrieval.) Tj T*
(   334 |         # Store conn.execute\('SELECT id,document_id,page,content FROM chunks\\n            WHERE tenant=%s) Tj T*
(       | ORDER BY embedding <=> %s LIMIT 20', \(tenant, vector\)\).fetchall\(\) in vector_rows.) Tj T*
(   335 |         vector_rows=conn.execute\('''SELECT id,document_id,page,content FROM chunks) Tj T*
(   336 |             WHERE tenant=%s ORDER BY embedding <=> %s LIMIT 20''',\(tenant,vector\)\).fetchall\(\)) Tj T*
(   337 |         # Store conn.execute\("SELECT id,document_id,page,content FROM chunks\\n            WHERE tenant=%s) Tj T*
(       | AND search_tsv @@ plainto_tsquery\('english',%s\)\\n             ORDER BY ts_rank_cd\(search_ts in) Tj T*
(       | lexical_rows.) Tj T*
(   338 |         lexical_rows=conn.execute\('''SELECT id,document_id,page,content FROM chunks) Tj T*
(   339 |             WHERE tenant=%s AND search_tsv @@ plainto_tsquery\('english',%s\)) Tj T*
(   340 |             ORDER BY ts_rank_cd\(search_tsv,plainto_tsquery\('english',%s\)\) DESC LIMIT 20''',) Tj T*
(   341 |             \(tenant,question,question\)\).fetchall\(\)) Tj T*
(   342 |     # Store reciprocal_rank_fusion\(vector_rows, lexical_rows\) in candidates.) Tj T*
(   343 |     candidates=reciprocal_rank_fusion\(vector_rows,lexical_rows\)) Tj T*
(   344 |     # Check not candidates; execute this branch only if true.) Tj T*
(   345 |     if not candidates: return []) Tj T*
(   346 |     global _reranker) Tj T*
() Tj T*
(   347 |     # Import dependencies used by the following code.) Tj T*
(   348 |     from sentence_transformers import CrossEncoder) Tj T*
(   349 |     # Check _reranker is None; execute this branch only if true.) Tj T*
(   350 |     if _reranker is None: _reranker=CrossEncoder\(C.rerank_model\)) Tj T*
(   351 |     # Store _reranker.predict\([\(question, row[3]\) for row in candidates]\) in relevance.) Tj T*
(   352 |     relevance=_reranker.predict\([\(question,row[3]\) for row in candidates]\)) Tj T*
(   353 |     # Store sorted\(zip\(candidates, relevance\), key=lambda x: float\(x[1]\), reverse=True\) in ranked.) Tj T*
(   354 |     ranked=sorted\(zip\(candidates,relevance\),key=lambda x:float\(x[1]\),reverse=True\)) Tj T*
