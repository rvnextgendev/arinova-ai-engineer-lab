(   280 |     authorize\(actor,'ingest',tenant\)) Tj T*
(   281 |     # Store list\(extract_pdf\(path\)\) in pages.) Tj T*
(   282 |     pages=list\(extract_pdf\(path\)\)) Tj T*
() Tj T*
() Tj T*
